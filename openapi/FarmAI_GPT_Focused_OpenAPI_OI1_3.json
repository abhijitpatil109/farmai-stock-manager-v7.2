  "components": {
    "securitySchemes": {
      "FarmAIApiKey": {
        "type": "apiKey",
        "description": "FarmAI Stock Manager API key",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "BatchPurchaseItem": {
        "properties": {
          "product_code": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Product Code"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Quantity"
          },
          "unit": {
            "type": "string",
            "maxLength": 20,
            "minLength": 1,
            "title": "Unit"
          },
          "location_code": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Location Code",
            "default": "MAIN"
          },
          "effective_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Effective At"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          }
        },
        "type": "object",
        "required": [
          "product_code",
          "quantity",
          "unit"
        ],
        "title": "BatchPurchaseItem"
      },
      "BatchPurchaseRequest": {
        "properties": {
          "idempotency_key": {
            "type": "string",
            "maxLength": 200,
            "minLength": 8,
            "title": "Idempotency Key"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/BatchPurchaseItem"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Items"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          }
        },
        "type": "object",
        "required": [
          "idempotency_key",
          "items"
        ],
        "title": "BatchPurchaseRequest"
      },
      "CreateProductRequest": {
        "properties": {
          "product_name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Product Name"
          },
          "category": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Category"
